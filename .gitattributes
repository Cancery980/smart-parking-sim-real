* text=auto
*.py text eol=lf
*.js text eol=lf
*.md text eol=lf
# Frozen metadata is hashed byte-for-byte; preserve its original line endings.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.pt binary
*.png binary
*.jpg binary
*.docx binary
