  "findings": [
    "s在自身开发门槛0.30下为TP943/FP27/FN9；n在自身开发门槛0.35下为TP943/FP28/FN9。实际新增优势只有1个FP，且漏检GT只有6个重合，另外各3个不同，不能说s已完全保留所有n成功案例。",
    "s的9个FN中7个已有conf>=0.20框但IoU为0.30至0.50，其中仅3个在0.45至0.50；另2个没有IoU>=0.30保留框。只有3个FN属于小框，整体不是普遍的输入分辨率不足。",
    "s的27个FP中20个属于小框、18个接近评分ROI边界，未发现满足重复GT定义的FP。PUCPR贡献14个FP，其中13个在左图像边，5个同时靠近上方ROI边；这些标志不能相加当互斥类别。",
    "查看两张UFPR04原始开发图可见，多处大框漏检位于树冠遮挡区；查看一张PUCPR原图可见边缘截断车辆部分。可见部分/遮挡是外观观察，不是对全部FP的语义定论，仍按冻结作者标注保留原FP/FN，不修标签或删除边缘。"
  ],
  "recommendations": [
    {
      "priority": 1,
      "candidate": "One calibrated-ROI inference ablation only",
      "worth_trying": "有限证据，成本低，可完成已有计划中的一次比较。",
      "settings": "使用固定作者相机ROI、imgsz1280、NMS0.70、augment=False；保持conf0.20证据及已冻结的开发选择规则，比较完整18dev。",
      "evidence": "PUCPR是唯一训练时裁去上方140px的视角，s在该视角FP由n校准后的8增加到14，其中5个接近上方ROI边；可检验输入背景/填充一致性。",
      "limits": "13/14 PUCPR FP靠左边，而ROI裁剪不改变左边界；不能预期它消除所有边缘FP。UFPR04/05的ROI为整图，故该消融不会直接解决9个FN。"
    },
    {
      "priority": 2,
      "candidate": "One native TTA ablation on the eventual development winner, conditional",
      "worth_trying": "仅在747训练后的开发误差仍以定位不匹配为主时考虑，最多一组，不做组合网格。",
      "settings": "保持最终开发候选权重、1280、conf0.20及NMS0.70，只将augment=False改为True；只跑18dev。",
      "evidence": "当前7/9 FN有0.30至0.50的重叠框，3个接近IoU0.50边界，翻转/多尺度分支可能改变定位；不是已证明会改善。",
      "limits": "当前版本是三个尺度前向，按尺度面积约2.14倍算量，不保证CPU耗时比例；可能增加边缘FP和unknown，应按P/R双门槛及占用代价决定保留。先等747开发结果，避免给即将淘汰的s270增加额外组合。"
    }
  ],
  "not_recommended_now": [
    "不加NMS阈值网格：s当前没有IoU>=0.50的重复GT型FP，更强抑制有误删相邻真车风险。",
    "不优先做1600输入或SAHI：只有3/9 FN是小框，多处严重遮挡或标注框与可见部分不一致；放大也可能增加当前大量小边缘FP。",
    "不做按位置删框或缩窄计分ROI：已存在真实边缘车辆GT，会改变既定评分范围并隐藏错误。"
  ],
